Job: "pre-fit"
  CmeLabel: "13 TeV"
  POI: "mu_LQ"
  ReadFrom: NTUP
  AtlasLabel: none
  Label: NONE
  OutputDir: ./outputs
  NtuplePaths: XXX_NtuplePaths
  FriendPath: XXX_FriendPaths
  LumiLabel: "140 fb^{-1}"
  Lumi: 1.0
  MCweight: "weight_total_NOSYS"
  NtupleName: "reco"
  MCstatThreshold: 0.01
  HistoChecks: NOCRASH
  SplitHistoFiles: TRUE
  ImageFormat: pdf,png
  DoSignalRegionsPlot: TRUE
  RatioYmin: 0.
  RatioYmax: 2.0
  ReplacementFile: replacements/replacement.txt
  DebugLevel: 2
  BlindingThreshold: 0.3
  PlotOptions: "YIELDS,NORATIO"
  # Selection: "(leps_IFFtype_0_NOSYS == 2 || leps_IFFtype_0_NOSYS == 4 || leps_IFFtype_0_NOSYS == 7) && (leps_IFFtype_1_NOSYS == 2 || leps_IFFtype_1_NOSYS == 4 || leps_IFFtype_1_NOSYS == 7)"

Fit: fit
  FitType: SPLUSB
  FitRegion: CRSR
  UseMinos: "mu_LQ"
  POIAsimov: 1

NormFactor: "mu_LQ"
  Title: "#mu (LQ)"
  Min: 0
  Max: 10
  Nominal: 1
  Constant: TRUE
  Samples: LQ

Limit: "limit"
	LimitType: ASYMPTOTIC

Significance: "significance"
    SignificanceType: ASYMPTOTIC
	POIAsimov: 1


INCLUDE: ../regions/regions.config

INCLUDE: ../samples/new.config
