Job: "pre-fit"
  CmeLabel: "13 TeV"
  POI: "mu_LQ"
  ReadFrom: NTUP
  AtlasLabel: none
  Label: NONE
  OutputDir: ./outputs
  NtuplePaths: XXX_NtuplePaths
  FriendPath: XXX_FriendPaths
  LumiLabel: "140 fb^{-1}"
  Lumi: 1.0
  MCweight: "weight_total_NOSYS"
  NtupleName: "reco"
  MCstatThreshold: 0.01
  HistoChecks: NOCRASH
  SplitHistoFiles: TRUE
  ImageFormat: pdf,png
  DoSignalRegionsPlot: TRUE
  RatioYmin: 0.
  RatioYmax: 2.0
  ReplacementFile: replacements/replacement.txt
  DebugLevel: 2
  BlindingThreshold: 0.1
  PlotOptions: "YIELDS,NORATIO"


Fit: fit
  FitType: SPLUSB
  FitRegion: CRSR
  FitBlind: TRUE
  UseMinos: "mu_LQ"


NormFactor: "mu_LQ"
  Title: "#mu (LQ)"
  Min: 0
  Max: 10
  Nominal: 1
  Constant: TRUE
  Samples: LQ


#### Regions ####
INCLUDE: ../regions/prefit.config


####  Samples  ####
INCLUDE: ../samples/background-fakes.config

INCLUDE: ../samples/signal.config
