Sample: "FakelPlusTau"
	FillColor: 883
	LineColor: 883
	Title: "Fake \ell+\tau"
	TexTitle: "$Fake \: \ell+\tau$"
	Type: BACKGROUND
	IgnoreSelection: "(leps_IFFtype_0_NOSYS == 2 || leps_IFFtype_0_NOSYS == 4 || leps_IFFtype_0_NOSYS == 7) && (leps_IFFtype_1_NOSYS == 2 || leps_IFFtype_1_NOSYS == 4 || leps_IFFtype_1_NOSYS == 7)"
	Selection: "!(leps_IFFtype_0_NOSYS == 2 || leps_IFFtype_0_NOSYS == 4 || leps_IFFtype_0_NOSYS == 7) || !(leps_IFFtype_1_NOSYS == 2 || leps_IFFtype_1_NOSYS == 4 || leps_IFFtype_1_NOSYS == 7) && !tau_truth_IsHadronicTau"
	NtupleFiles: XXX_FakeTau_ttbar_samples, XXX_FakeTau_Wjets_samples, XXX_FakeTau_Zjets_samples
	#UseFriend: TRUE

Sample: "FakeTau"
	FillColor: 824
	LineColor: 824
	Title: "Fake \tau"
	TexTitle: "$Fake \: \tau$"
	Type: BACKGROUND
	IgnoreSelection: "(leps_IFFtype_0_NOSYS == 2 || leps_IFFtype_0_NOSYS == 4 || leps_IFFtype_0_NOSYS == 7) && (leps_IFFtype_1_NOSYS == 2 || leps_IFFtype_1_NOSYS == 4 || leps_IFFtype_1_NOSYS == 7)"
	Selection: !tau_truth_IsHadronicTau
	NtupleFiles: XXX_ttbar_samples, XXX_SingleTop_samples, XXX_ttW_samples, XXX_ttH_samples, XXX_tZ_samples, XXX_ttgamma_samples, XXX_FakeTau_ttbar_samples, XXX_FakeTau_Wjets_samples, XXX_FakeTau_Zjets_samples
	#UseFriend: TRUE

