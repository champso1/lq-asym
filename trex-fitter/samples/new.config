Sample: "Data"
	Title: "Data Run 2"
	Type: DATA
	NtupleFiles: data/Data_0_2015_data, data/Data_0_2016_data, data/Data_0_2017_data, data/Data_0_2018_data
	IgnoreSelection: "(leps_IFFtype_0_NOSYS == 2 || leps_IFFtype_0_NOSYS == 4 || leps_IFFtype_0_NOSYS == 7) && (leps_IFFtype_1_NOSYS == 2 || leps_IFFtype_1_NOSYS == 4 || leps_IFFtype_1_NOSYS == 7)"
	# UseFriend: TRUE

