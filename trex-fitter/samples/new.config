Sample: "FakeEl"
	FillColor: 799
	LineColor: 799
	Title: "Fake e"
	TexTitle: "$Fake \: e$"
	Type: BACKGROUND
	IgnoreSelection: "(leps_IFFtype_0_NOSYS == 2 || leps_IFFtype_0_NOSYS == 4 || leps_IFFtype_0_NOSYS == 7) && (leps_IFFtype_1_NOSYS == 2 || leps_IFFtype_1_NOSYS == 4 || leps_IFFtype_1_NOSYS == 7)"
	Selection: "(leps_flav_0_NOSYS == 0 && !(leps_IFFtype_0_NOSYS == 2 || leps_IFFtype_0_NOSYS == 4 || leps_IFFtype_0_NOSYS == 7) && (leps_IFFtype_1_NOSYS == 2 || leps_IFFtype_1_NOSYS == 4 || leps_IFFtype_1_NOSYS == 7)) || ((leps_IFFtype_0_NOSYS == 2 || leps_IFFtype_0_NOSYS == 4 || leps_IFFtype_0_NOSYS == 7) && leps_flav_1_NOSYS == 0 && !(leps_IFFtype_1_NOSYS == 2 || leps_IFFtype_1_NOSYS == 4 || leps_IFFtype_1_NOSYS == 7))"
	NtupleFiles: XXX_ttbar_samples, XXX_ttH_samples, XXX_ttW_samples, XXX_SingleTop_samples, XXX_tZ_samples, XXX_ttgamma_samples
	#UseFriend: TRUE

Sample: "FakeMu"
	FillColor: 897
	LineColor: 897
	Title: "Fake \mu"
	TexTitle: "$Fake \: \mu$"
	Type: BACKGROUND
	IgnoreSelection: "(leps_IFFtype_0_NOSYS == 2 || leps_IFFtype_0_NOSYS == 4 || leps_IFFtype_0_NOSYS == 7) && (leps_IFFtype_1_NOSYS == 2 || leps_IFFtype_1_NOSYS == 4 || leps_IFFtype_1_NOSYS == 7)"
	Selection: "(leps_flav_0_NOSYS == 1 && !(leps_IFFtype_0_NOSYS == 2 || leps_IFFtype_0_NOSYS == 4 || leps_IFFtype_0_NOSYS == 7) && (leps_IFFtype_1_NOSYS == 2 || leps_IFFtype_1_NOSYS == 4 || leps_IFFtype_1_NOSYS == 7)) || ((leps_IFFtype_0_NOSYS == 2 || leps_IFFtype_0_NOSYS == 4 || leps_IFFtype_0_NOSYS == 7) && leps_flav_1_NOSYS == 1 && !(leps_IFFtype_1_NOSYS == 2 || leps_IFFtype_1_NOSYS == 4 || leps_IFFtype_1_NOSYS == 7))"
	NtupleFiles: XXX_ttbar_samples, XXX_ttH_samples, XXX_ttW_samples, XXX_SingleTop_samples, XXX_tZ_samples, XXX_ttgamma_samples
	#UseFriend: TRUE

